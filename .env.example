# ─────────────────────────────────────────────────────────────────────────────
# ShelfWatch — Environment Variables Example
# Copy this to .env.local for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase / Neon) ──────────────────────────────────────────────
# In Prisma 7, connection URLs must be specified in the config, not in schema.
# DIRECT_URL is used by Prisma Migrate (connects to port 5432)
# DATABASE_URL is used by runtime Prisma Client (pooled via port 6543 for serverless)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ── Supabase Storage (Required fallback for uploads) ──────────────────────────
# Required when BLOB_READ_WRITE_TOKEN is left blank.
# Obtain from: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1Ni..."
# The name of the storage bucket created in Supabase Dashboard (e.g. "scans")
SUPABASE_STORAGE_BUCKET="scans"

# ── Urdu Translation / Verdict Reasoning: Google Gemini (Free Tier) ───────────
# Obtain a free API key at: https://aistudio.google.com
GEMINI_API_KEY="AIzaSy..."

# ── Computer Vision (CLIP Zero-Shot Verification): Hugging Face ────────────────
# Obtain a read token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_..."
# Optional override for the default CLIP model
# HF_MODEL_ID="openai/clip-vit-large-patch14"

# ── WhatsApp Cloud API Webhook Integration ────────────────────────────────────
# All values from Meta for Developers → WhatsApp Dashboard
WHATSAPP_VERIFY_TOKEN="shelfwatch_verify_2026"
WHATSAPP_APP_SECRET="abc123..."
WHATSAPP_ACCESS_TOKEN="EAABs..."
WHATSAPP_PHONE_NUMBER_ID="123456789012345"

# ── OPTIONAL: Vercel / External APIs (Safe to leave blank) ─────────────────────
BLOB_READ_WRITE_TOKEN=""
GOOGLE_VISION_API_KEY=""
OCR_SPACE_API_KEY=""
REPLICATE_API_KEY=""

# ── Barcode Lookup APIs (Real verification fallback pipeline) ──────────────────
# UPCITEMDB_API_KEY="" # not required for free trial — only needed if upgrading to paid DEV/PRO plan at https://api.upcitemdb.com/prod/v1/
# OPENFOODFACTS_API_KEY="" # not required — Open Food Facts is a public, keyless API
BARCODELOOKUP_API_KEY="your_barcodelookup_key_here"
