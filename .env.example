# ─────────────────────────────────────────────────────────────────────────────
# ShelfWatch — Environment Variables
# Copy this to .env.local for local development.
# In Vercel: add all of these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Neon (https://neon.tech) or Supabase (https://supabase.com)
# Neon provides two URLs: pooled (for serverless) and direct (for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/shelfwatch?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/shelfwatch?sslmode=require"

# ── Vercel Blob ───────────────────────────────────────────────────────────────
# Automatically set when you add Vercel Blob storage in the Vercel dashboard.
# Manually: https://vercel.com/docs/storage/vercel-blob/quickstart
BLOB_READ_WRITE_TOKEN="verbl_..."

# ── OCR: Google Cloud Vision ──────────────────────────────────────────────────
# 1. Enable Cloud Vision API at https://console.cloud.google.com/apis/library/vision.googleapis.com
# 2. Create an API key: APIs & Services → Credentials → Create Credentials → API Key
# 3. Restrict the key to Vision API only
GOOGLE_VISION_API_KEY="AIza..."

# ── OCR Fallback: OCR.space ───────────────────────────────────────────────────
# Free tier at https://ocr.space/ocrapi — get a free API key
OCR_SPACE_API_KEY="helloworld"

# ── Computer Vision: Hugging Face ─────────────────────────────────────────────
# Create a token at https://huggingface.co/settings/tokens (read scope is enough)
HUGGINGFACE_API_KEY="hf_..."
# Optional: override the default CLIP model
# HF_MODEL_ID="openai/clip-vit-large-patch14"

# ── Computer Vision Fallback: Replicate ───────────────────────────────────────
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_KEY="r8_..."

# ── Urdu Translation / Verdict Reasoning: Anthropic Claude ───────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# All values from Meta for Developers → WhatsApp → Getting Started
# 1. Create an app at https://developers.facebook.com
# 2. Add WhatsApp product to the app
# 3. Configure a webhook pointing to: https://your-domain.vercel.app/api/whatsapp-webhook

# Arbitrary string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN="shelfwatch_verify_2026"

# App Secret from: App Dashboard → Settings → Basic → App Secret
WHATSAPP_APP_SECRET="abc123..."

# Temporary or permanent access token from the WhatsApp Getting Started page
WHATSAPP_ACCESS_TOKEN="EAABs..."

# Phone Number ID from the WhatsApp Getting Started page
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
